    <!-- GSAP Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.0/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.0/ScrollTrigger.min.js"></script>
 
<script>
gsap.registerPlugin(ScrollTrigger);

const container = document.querySelector(".containerrr");
const section = document.querySelector(".fixed-section");
const slides = document.querySelectorAll(".lg-slide");
const contentImages = document.querySelectorAll(".content-itmee img");
const paragraphs = document.querySelectorAll(".content-itmee p");
const slideNumbers = document.querySelectorAll(".slidesofnumber");

// Initially hide all slide numbers except the first one
gsap.set(slideNumbers, { opacity: 0 });
gsap.set(slideNumbers[0], { opacity: 1 });

// Pin the section while scrolling
ScrollTrigger.create({
    trigger: container,
    start: "top top",
    end: `+=${window.innerHeight * slides.length}`,
    pin: section,
    anticipatePin: 1,
    scrub: true,
    onLeave: () => {
        gsap.set(section, { position: "relative" });
    }
});

// Background Image Scroll Animation
gsap.set(slides[0], { opacity: 1 });

slides.forEach((slide, index) => {
    if (index === 0) return;

    gsap.to(slide, {       
        duration: 1.5,
        "--mask-gradient": `linear-gradient(
            0deg,
            black 0% 3.33%, transparent 3.33% 3.33%, black 3.33% 6.66%, transparent 6.66% 6.66%, 
            black 6.66% 10%, transparent 10% 10%, black 10% 13.33%, transparent 13.33% 13.33%, 
            black 13.33% 16.66%, transparent 16.66% 16.66%, black 16.66% 20%, transparent 20% 20%, 
            black 20% 23.33%, transparent 23.33% 23.33%, black 23.33% 26.66%, transparent 26.66% 26.66%, 
            black 26.66% 30%, transparent 30% 30%, black 30% 33.33%, transparent 33.33% 33.33%, 
            black 33.33% 36.66%, transparent 36.66% 36.66%, black 36.66% 40%, transparent 40% 40%, 
            black 40% 43.33%, transparent 43.33% 43.33%, black 43.33% 46.66%, transparent 46.66% 46.66%, 
            black 46.66% 50%, transparent 50% 50%, black 50% 53.33%, transparent 53.33% 53.33%, 
            black 53.33% 56.66%, transparent 56.66% 56.66%, black 56.66% 60%, transparent 60% 60%, 
            black 60% 63.33%, transparent 63.33% 63.33%, black 63.33% 66.66%, transparent 66.66% 66.66%, 
            black 66.66% 70%, transparent 70% 70%, black 70% 73.33%, transparent 73.33% 73.33%, 
            black 73.33% 76.66%, transparent 76.66% 76.66%, black 76.66% 80%, transparent 80% 80%, 
            black 80% 83.33%, transparent 83.33% 83.33%, black 83.33% 86.66%, transparent 86.66% 86.66%, 
            black 86.66% 90%, transparent 90% 90%, black 90% 93.33%, transparent 93.33% 93.33%, 
            black 93.33% 96.66%, transparent 96.66% 96.66%, black 96.66% 100%, transparent 100% 100%
        )`,
        scrollTrigger: {
            trigger: ".containerrr",
            start: `top+=${index * window.innerHeight} center`,
            end: `top+=${(index + 1) * window.innerHeight} center`,
            scrub: true,
            toggleActions: "play reverse play reverse"
        }
    });

    gsap.to(slides[index - 1], {  
        duration: 1,
        scrollTrigger: {
            trigger: ".containerrr",
            start: `top+=${index * window.innerHeight} center`,
            end: `top+=${(index + 1) * window.innerHeight} center`,
            scrub: true,
            toggleActions: "play reverse play reverse"
        }
    });
});

// Scroll-triggered animations for small images & slide number updates
contentImages.forEach((image, index) => {
    gsap.to(image, {            
        duration: 3,
        ease: "power2.out",
        "--mask": 'inset(0% 0% 0% 0%)',
        scrollTrigger: {
            trigger: ".containerrr",
            start: `top+=${index * window.innerHeight} center`,
            end: `top+=${(index + 1) * window.innerHeight} top`,
            scrub: true,
            onEnter: () => {
                gsap.to(slideNumbers, { opacity: 0, duration: 0.5 }); // Hide all numbers
                gsap.to(slideNumbers[index], { opacity: 1, duration: 1 }); // Fade in the active number
            },
            onLeaveBack: () => {
                gsap.to(slideNumbers, { opacity: 0, duration: 0.5 }); // Hide all numbers
                gsap.to(slideNumbers[index], { opacity: 1, duration: 1 }); // Fade in previous number
            }
        }
    });
});

// Scroll-triggered animations for paragraphs inside .content-itmee
gsap.set(paragraphs[0], { opacity: 1, y: 0 });

paragraphs.forEach((para, index) => {
    if (index > 0) {
        gsap.set(para, { opacity: 0, y: 20 });
    }
    
    gsap.to(para, {            
        duration: 3,
        ease: "power2.out",
        opacity: 1,
        y: 0,
        scrollTrigger: {
            trigger: ".containerrr",
            start: `top+=${index * window.innerHeight} center`,
            end: `top+=${(index + 1) * window.innerHeight} top`,
            scrub: true,
        }
    });

    gsap.to(paragraphs[index - 1], {  
        opacity: 0,
        y: -20,
        duration: 2,
        scrollTrigger: {
            trigger: ".containerrr",
            start: `top+=${index * window.innerHeight} center`,
            end: `top+=${(index + 1) * window.innerHeight} top`,
            scrub: true,
        }
    });
});


</script>

 
